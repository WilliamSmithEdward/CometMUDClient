<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the application icon and writes the .ico, .icns and .png files the app ships.
       Run it with "dotnet run" and the project option pointing at tools/IconGenerator. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Comet.Tools.IconGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
</Project>
