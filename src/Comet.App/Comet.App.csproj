<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Comet</AssemblyName>
    <RootNamespace>Comet.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/comet.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- AVLN3001: SessionView is only ever created in code with its session, never by the runtime XAML loader. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Comet.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by tools/IconGenerator. comet.icns is used only when packaging for macOS. -->
    <AvaloniaResource Include="Assets/comet.ico" />
    <AvaloniaResource Include="Assets/comet.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Comet.Core\Comet.Core.csproj" />
  </ItemGroup>
</Project>
