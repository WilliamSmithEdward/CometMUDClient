<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Comet.App.Controls"
        x:Class="Comet.App.Dialogs.PreferencesDialog"
        Title="Preferences"
        Width="660" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16" RowDefinitions="*,Auto">
    <TabControl Grid.Row="0" Padding="0,12,0,0">

      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,12,130">
              <StackPanel Grid.Column="0" Spacing="4">
                <Label Target="{Binding #FontBox}" Content="_Font" Padding="0" />
                <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <Label Target="{Binding #FontSizeBox}" Content="_Size" Padding="0" />
                <NumericUpDown x:Name="FontSizeBox" Minimum="6" Maximum="72" Increment="1" FormatString="0" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="hint" Text="A fixed-width font keeps maps and tables from the MUD lined up." />

            <TextBlock Text="Colors" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Classes="hint" Text="Enter colors as #RRGGBB. The first row of ANSI colors is the normal set, the second the bright set." />
            <Grid x:Name="BaseColors" ColumnDefinitions="*,12,*" />
            <UniformGrid x:Name="PaletteGrid" Columns="4" />
            <CheckBox x:Name="BoldBrightBox" Content="Show _bold text in bright colors instead of a heavier font" />

            <StackPanel Spacing="4">
              <TextBlock Text="Preview" FontWeight="SemiBold" />
              <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Height="112">
                <controls:OutputView x:Name="Preview" AlwaysFollow="True" />
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Behavior">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="0,0,8,0">
            <StackPanel Spacing="4">
              <Label Target="{Binding #ScrollbackBox}" Content="_Scrollback lines kept per session" Padding="0" />
              <NumericUpDown x:Name="ScrollbackBox" Minimum="100" Maximum="1000000" Increment="1000" FormatString="0" Width="180" HorizontalAlignment="Left" />
              <TextBlock Classes="hint" Text="From 100 to 1,000,000. Older lines are dropped." />
            </StackPanel>
            <CheckBox x:Name="WordWrapBox" Content="_Wrap long lines to the window width" />
            <CheckBox x:Name="EchoBox" Content="Show the commands I send in the _output" />
            <CheckBox x:Name="KeepInputBox" Content="_Keep the last command selected after sending, so Enter repeats it" />
            <CheckBox x:Name="BellBox" Content="Play a sound for the _bell (Windows only; the status bar always shows it)" />
            <CheckBox x:Name="ConfirmCloseBox" Content="_Ask before closing a tab or the window while connected" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button x:Name="DefaultsButton" Grid.Column="0" Content="Restore _Defaults" />
      <TextBlock x:Name="ErrorText" Grid.Column="1" Classes="error" VerticalAlignment="Center" Margin="16,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="88" HorizontalContentAlignment="Center" />
        <Button x:Name="OkButton" Classes="accent" Content="OK" IsDefault="True" MinWidth="88" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
